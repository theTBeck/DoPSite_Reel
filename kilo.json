{
  "name": "DoPSite_Reel",
  "description": "Cine Beck — Diretor de Fotografia portfolio site",
  "type": "static-site",
  "language": "javascript",
  "framework": "vanilla-js",
  "scripts": {
    "dev": "npx serve .",
    "build": "echo 'No build step required for static site'",
    "preview": "npx serve ."
  },
  "devServer": {
    "command": "npx serve .",
    "port": 3000,
    "readyPattern": "serving"
  },
  "lint": {
    "command": "npx eslint js/ --ext .js",
    "config": "eslint.config.js"
  },
  "format": {
    "command": "npx prettier --write ."
  },
  "test": {
    "command": "echo 'No tests configured'"
  }
}